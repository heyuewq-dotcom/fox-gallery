{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Fox Gallery user backup v1",
  "type":"object",
  "required":["format","schemaVersion","users"],
  "properties":{
    "format":{"const":"fox-gallery-user-data"},
    "schemaVersion":{"const":1},
    "exportedAt":{"type":"string"},
    "users":{"type":"array","maxItems":100000,"items":{"type":"object","required":["sha256","favorite","tags","category","note"],"properties":{
      "sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},"favorite":{"type":"boolean"},"tags":{"type":"array","maxItems":200,"items":{"type":"string","maxLength":200}},"category":{"type":"string","maxLength":120},"note":{"type":"string","maxLength":20000},"hidden":{"type":"boolean"}
    }}}
  }
}
